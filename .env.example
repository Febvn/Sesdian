# ============================================================
#  SESDIAN - local environment. Copy this file to ".env.local"
#  and fill in your values. ".env.local" is gitignored (never committed).
#  cp .env.example .env.local
# ============================================================

# Neon Postgres connection string.
# Neon dashboard -> your project -> "Connection Details" -> copy the
# connection string (the POOLED one is fine). Keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Secret used to sign login tokens. Any long random string works for local.
# To match production, copy the same JWT_SECRET from your Vercel project env.
JWT_SECRET=ganti-dengan-string-acak-panjang

# Optional: WhatsApp auto-send gateway (Fonnte). Leave blank to use wa.me links.
FONNTE_TOKEN=

# Scheduled task (Vercel Cron, daily 08.00 WIB): overdue WhatsApp reminders.
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>"; without it the cron
# call is rejected. Any long random string, e.g. openssl rand -hex 32
CRON_SECRET=
