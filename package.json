{
  "name": "sesdian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SESDIAN asset management — static frontend + Neon-backed serverless API",
  "scripts": {
    "dev": "node dev-server.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:run": "node scripts/run-sql.mjs",
    "db:migrate": "node scripts/run-sql.mjs db/migrate-v3.sql",
    "db:seed": "node scripts/run-sql.mjs db/seed-aset-2025.sql",
    "db:setup": "node scripts/run-sql.mjs db/migrate-v3.sql && node scripts/run-sql.mjs db/seed-aset-2025.sql",
    "test": "node --test tests/*.test.mjs",
    "test:all": "node --test tests/*.test.mjs && node scripts/test-e2e.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "pdf:laporan": "node scripts/render-laporan-pdf.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
